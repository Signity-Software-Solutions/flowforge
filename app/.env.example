# Public portfolio mode (default): virtual providers, browser-local state; no database required
NEXT_PUBLIC_DEMO_MODE="true"

# The variables below are only for the legacy backend mode.
# Database
DATABASE_URL="postgresql://user:password@localhost:5432/flowforge"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# n8n
N8N_BASE_URL="http://localhost:5678"
N8N_API_KEY="your-n8n-api-key"
N8N_MOCK="true"

# Claude AI
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"
